# Copy to .env (never commit .env). These values are read ONLY by the Node server.
# Do not prefix any of them with VITE_ — that would expose them to the browser.

# --- Choose one provider: edge | openai | elevenlabs | mock | none -----------
# If omitted: OpenAI if OPENAI_API_KEY is set, else ElevenLabs if its key is set,
# else "edge" — free Microsoft Edge neural voices (no key; unofficial, may break).
TTS_PROVIDER=edge

# --- OpenAI -------------------------------------------------------------------
OPENAI_API_KEY=sk-replace-me
# gpt-4o-mini-tts supports delivery "instructions" (style). tts-1 / tts-1-hd ignore style.
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- ElevenLabs ---------------------------------------------------------------
ELEVENLABS_API_KEY=replace-me
ELEVENLABS_MODEL=eleven_multilingual_v2
# Voice IDs (from your ElevenLabs voice library) assigned to the three personas.
ELEVENLABS_VOICE_MALE_ID=
ELEVENLABS_VOICE_FEMALE_ID=
ELEVENLABS_VOICE_NEUTRAL_ID=

# --- Server -------------------------------------------------------------------
PORT=8787
# Optional shared secret. If set, every /api call needs "Authorization: Bearer <token>"
# (enter it in Settings → Server access token). Strongly recommended if you expose the server.
APP_ACCESS_TOKEN=
# Generated audio is cached on disk to avoid duplicate billing, then purged after this many hours.
AUDIO_RETENTION_HOURS=24
CACHE_DIR=server/.cache
TTS_TIMEOUT_MS=60000
GENERATE_LIMIT_PER_MINUTE=60

# --- Development / tests only -------------------------------------------------
# TTS_PROVIDER=mock produces synthetic tones (NOT speech). It is refused when
# NODE_ENV=production unless you explicitly set ALLOW_MOCK_IN_PRODUCTION=true.
# ALLOW_MOCK_IN_PRODUCTION=false
